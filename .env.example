# Copy to .env and fill in. .env is gitignored — secrets never get committed.

# --- Telegram bot message (instant push) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token below.
# 2. Message @userinfobot (or your new bot) to get your numeric chat id.
# 3. IMPORTANT: send your new bot one message (e.g. "hi") so it may message you.
TELEGRAM_BOT_TOKEN=<<PASTE_BOT_TOKEN_FROM_BOTFATHER>>
TELEGRAM_CHAT_ID=<<PASTE_YOUR_NUMERIC_CHAT_ID>>

# --- CallMeBot ringing Telegram call (wakes you up) ---
# 1. You need a Telegram @username (Settings -> Username).
# 2. Open https://t.me/CallMeBot_txtbot and press Start once to authorize calls.
CALLMEBOT_TG_USER=<<@your_telegram_username>>

# --- Behavior (defaults are fine) ---
ENABLE_TELEGRAM=1
ENABLE_CALL=1
CATEGORY_VALUE=12
MONTHS_TO_SCAN=2
INTERVAL_MIN=35
INTERVAL_MAX=75
SELF_TEST=0

{
  "_README": "Change 'watch' to pick calendars (keys from 'targets'). Inside hot_hours_utc it checks every poll_seconds_hot across hot_months; otherwise every poll_seconds_rest. All months are swept at least every full_sweep_seconds. Times are UTC, Tashkent is UTC+5.",
  "watch": [
    "short_stay_representative",
    "short_stay_applicant"
  ],
  "targets": {
    "short_stay_representative": {
      "category": 12,
      "event": 21,
      "headline": "REPRESENTATIVE",
      "label": "Short stay - Representative or Travel Agency"
    },
    "short_stay_applicant": {
      "category": 12,
      "event": 20,
      "headline": "INDIVIDUAL",
      "label": "Short stay - Applicant (individual)"
    },
    "coe_representative": {
      "category": 15,
      "event": 17,
      "headline": "COE REPRESENTATIVE",
      "label": "With COE - Representative"
    },
    "coe_applicant": {
      "category": 15,
      "event": 22,
      "plan": 14,
      "headline": "COE INDIVIDUAL",
      "label": "With COE - Applicant"
    },
    "govdocs_representative": {
      "category": 16,
      "event": 18,
      "headline": "GOV DOCS REPRESENTATIVE",
      "label": "With Government Documents - Representative"
    },
    "govdocs_applicant": {
      "category": 16,
      "event": 23,
      "headline": "GOV DOCS INDIVIDUAL",
      "label": "With Government Documents - Applicant"
    }
  },
  "months_ahead": 2,
  "hot_hours_utc": [
    11,
    16
  ],
  "poll_seconds_hot": 5,
  "poll_seconds_rest": 60,
  "hot_months": 2,
  "full_sweep_seconds": 60,
  "stale_read_warning_seconds": 180,
  "alarm_repeat_seconds": 10,
  "alarm_max_seconds": 900,
  "daily_report_hour_tashkent": 21,
  "run_minutes": 300,
  "seat_probe_seconds": 15
}
